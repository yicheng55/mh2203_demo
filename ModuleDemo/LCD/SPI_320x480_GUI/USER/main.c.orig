#include <stdlib.h>
#include <string.h>
#include <stdio.h>
#include "delay.h"
#include "mh2203.h"
#include "Spi_Base.h"
#include "User_Inc.h"
#include "lv_port_disp_template.h"
#include "lvgl.h"
#include "demos/lv_demos.h"

#define PRINTF_LOG 	printf

USART_TypeDef* USART_TEST = USART1;
uint16_t DMA_ADC_Value[1];
void UART_Configuration(uint32_t bound);
void RCC_ClkConfiguration(void);
void GPIO_Configuration(void);
void ADC_CFG(void);
int main(void)
{	
	RCC_ClocksTypeDef clocks;
    uint16_t bar_Value=0;
	
	RCC_ClkConfiguration();
	Delay_Init();
	GPIO_Configuration();
	RCC_GetClocksFreq(&clocks);
	TIM_Configuration();
	ST7796_Init();
	lv_init();
	lv_port_disp_init();
	    ADC_CFG();

    lv_obj_t* arc = lv_arc_create(lv_scr_act());
    lv_arc_set_range(arc, 0, 4095);  /* 设置arc 的范围 */
    lv_arc_set_value(arc, 0);      /* 设置arc 的值 */
    lv_obj_set_size(arc, 100, 100);
    lv_obj_align_to(arc, NULL, LV_ALIGN_CENTER, 0, 0);

    lv_obj_t* label = lv_label_create(lv_scr_act());
    lv_label_set_text_fmt(label, "PB0=%d", 0);  // 显示数字
    lv_obj_center(label);

    lv_obj_t* bar = lv_bar_create(lv_scr_act());
    lv_bar_set_range(bar, 0, 100);
    lv_bar_set_value(bar, 50, LV_ANIM_ON);
    lv_obj_set_size(bar, 200, 20);
    lv_obj_align(bar, NULL, LV_ALIGN_CENTER, 0);

    lv_obj_t* button = lv_btn_create(lv_scr_act());
    lv_obj_set_size(button,100, 50);
    lv_obj_align(button, NULL, 10, 50);

    lv_obj_t* checkbox = lv_checkbox_create(lv_scr_act());
    lv_checkbox_set_text(checkbox, "Check");
    lv_obj_set_size(checkbox, 100, 50);
    lv_obj_align(checkbox, NULL, 10, 120);
    lv_obj_add_state(checkbox, true);

    lv_obj_t* sw = lv_switch_create(lv_scr_act());
    lv_obj_set_size(sw, 100, 50);
    lv_obj_align(sw, NULL, 10, 150);
    lv_obj_add_state(sw, true);


		// 屏幕大小
const int screen_width = 200;
const int screen_height = 200;

// 坐标原点 (起点设置为屏幕左下角)
const int origin_x = 0;  // 原点 X 偏移
const int origin_y = screen_height - 40;  // 原点 Y 偏移

// 创建主屏幕
lv_obj_t* scr = lv_scr_act();

// 横轴 X
static lv_point_t x_axis_points[] = {
    {origin_x, origin_y},
    {screen_width - 10, origin_y}  // 横轴到右边界
};
lv_obj_t* x_axis = lv_line_create(scr);
lv_line_set_points(x_axis, x_axis_points, 2);
lv_obj_align(x_axis, LV_ALIGN_TOP_LEFT, 30, 280);

// 纵轴 Y
static lv_point_t y_axis_points[] = {
    {origin_x, 10},
    {origin_x, origin_y}  // 纵轴到顶部
};
lv_obj_t* y_axis = lv_line_create(scr);
lv_line_set_points(y_axis, y_axis_points, 2);
lv_obj_align(y_axis, LV_ALIGN_TOP_LEFT, 30, 280);

// 设置线条样式
static lv_style_t axis_style;
lv_style_init(&axis_style);
lv_style_set_line_width(&axis_style, 2);           // 轴线宽度
lv_style_set_line_color(&axis_style, lv_color_black());  // 轴线颜色
lv_obj_add_style(x_axis, &axis_style, LV_PART_MAIN);
lv_obj_add_style(y_axis, &axis_style, LV_PART_MAIN);


// 折线图数据点（基于原点的相对坐标）
lv_point_t line_points[] = {
    {origin_x + 10, origin_y - 10},   // 第1个点 (50, 50)
    {origin_x + 50, origin_y - 30},  // 第2个点 (90, 30)
    {origin_x + 90, origin_y - 70},  // 第3个点 (130, 70)
    {origin_x + 130, origin_y - 50}, // 第4个点 (170, 50)
    {origin_x + 170, origin_y - 90},  // 第5个点 (210, 90)
    {origin_x + 200, origin_y - 90}  // 第6个点 (210, 90)
};

// 创建线条对象
lv_obj_t* line1 = lv_line_create(lv_scr_act());
lv_line_set_points(line1, line_points, 5);  // 设置点的数组和数量

// 设置线条样式
static lv_style_t line_style;
lv_style_init(&line_style);
lv_style_set_line_width(&line_style, 3);              // 线宽
lv_style_set_line_rounded(&line_style, false);        // 线条端点是否圆角
lv_obj_add_style(line1, &line_style, LV_PART_MAIN);

// 让折线与坐标系对齐
lv_obj_align(line1, LV_ALIGN_TOP_LEFT, 30, 280);


	
	while(1)
	{		
		 lv_arc_set_value(arc, DMA_ADC_Value[0]);      /* 设置arc 的值 */
        lv_label_set_text_fmt(label, "PB0=%d", DMA_ADC_Value[0]);  // 显示数字
        lv_bar_set_value(bar, bar_Value, LV_ANIM_ON);
        if (bar_Value < 100)
        {
            bar_Value++;
					
        }
        else {
            bar_Value = 0;
        }
				if(bar_Value>50)
				{
    lv_obj_add_state(sw, LV_STATE_CHECKED);
    lv_obj_add_state(checkbox, LV_STATE_CHECKED);
				}else{
    lv_obj_clear_state(sw, LV_STATE_CHECKED);
    lv_obj_clear_state(checkbox, LV_STATE_CHECKED);
				
				}
   
		 lv_task_handler();
		Delay_Ms(10);
			}
}

void DMA_Configuration(void)
{
    NVIC_InitTypeDef NVIC_InitStructure;
    DMA_InitTypeDef DMA_InitStructure;

    RCC_AHBPeriphClockCmd(RCC_AHBPeriph_DMA1,ENABLE);
    DMA_DeInit(DMA1_Channel1);
    DMA_InitStructure.DMA_PeripheralBaseAddr = (uint32_t)&ADC1->DR;
    DMA_InitStructure.DMA_MemoryBaseAddr = (uint32_t)DMA_ADC_Value;
    DMA_InitStructure.DMA_DIR = DMA_DIR_PeripheralSRC;
    DMA_InitStructure.DMA_BufferSize = 1;
    DMA_InitStructure.DMA_PeripheralInc = DMA_PeripheralInc_Disable;
    DMA_InitStructure.DMA_MemoryInc = DMA_MemoryInc_Enable;
    DMA_InitStructure.DMA_PeripheralDataSize = DMA_PeripheralDataSize_HalfWord;
    DMA_InitStructure.DMA_MemoryDataSize = DMA_MemoryDataSize_HalfWord;
    DMA_InitStructure.DMA_Mode = DMA_Mode_Circular;
    DMA_InitStructure.DMA_Priority = DMA_Priority_High;
    DMA_InitStructure.DMA_M2M = DMA_M2M_Disable;
    DMA_Init(DMA1_Channel1,&DMA_InitStructure);
    DMA_Cmd(DMA1_Channel1,ENABLE);
    ADC_DMACmd(ADC1,ENABLE);
}
void ADC_CFG(void)
{
    uint32_t i;
    ADC_InitTypeDef ADC_InitStructure;
    GPIO_InitTypeDef GPIO_InitStructure;

    RCC_APB2PeriphClockCmd(RCC_APB2Periph_GPIOB | RCC_APB2Periph_ADC1, ENABLE );

    GPIO_InitStructure.GPIO_Pin =GPIO_Pin_0;
    GPIO_InitStructure.GPIO_Speed = GPIO_Speed_50MHz;
    GPIO_InitStructure.GPIO_Mode = GPIO_Mode_AIN;
    GPIO_Init(GPIOB, &GPIO_InitStructure);

    RCC_ADCCLKConfig(RCC_PCLK2_Div8);
    ADC_DeInit(ADC1);

    ADC_InitStructure.ADC_Mode = ADC_Mode_Independent;
    ADC_InitStructure.ADC_ScanConvMode = ENABLE;
    ADC_InitStructure.ADC_ContinuousConvMode = ENABLE;
    ADC_InitStructure.ADC_ExternalTrigConv = ADC_ExternalTrigConv_None;
    ADC_InitStructure.ADC_DataAlign = ADC_DataAlign_Right;
    ADC_InitStructure.ADC_NbrOfChannel = 1;
    ADC_Init(ADC1, &ADC_InitStructure);

    ADC_RegularChannelConfig(ADC1,ADC_Channel_8,1,ADC_SampleTime_239Cycles5);

    ADC_SoftwareStartConvCmd(ADC1, ENABLE);

    ADC_Cmd(ADC1, ENABLE);

    ADC_ResetCalibration(ADC1);
    while(ADC_GetResetCalibrationStatus(ADC1));
    ADC_StartCalibration(ADC1);
    while(ADC_GetCalibrationStatus(ADC1));

    DMA_Configuration();
    ADC_SoftwareStartConvCmd(ADC1,ENABLE);
}
void RCC_ClkConfiguration(void)
{
	RCC_DeInit();

	RCC_HSEConfig(RCC_HSE_ON);
	while(RCC_GetFlagStatus(RCC_FLAG_HSERDY) == RESET);
	
	RCC_PLLCmd(DISABLE);
	
	FLASH_SetLatency(FLASH_Latency_2);
	
	RCC_PLLConfig(RCC_PLLSource_HSE_Div1,RCC_PLLMul_27);
	
	RCC_PLLCmd(ENABLE);
	while(RCC_GetFlagStatus(RCC_FLAG_PLLRDY) == RESET);
	
	RCC_SYSCLKConfig(RCC_SYSCLKSource_PLLCLK);
	
	RCC_HCLKConfig(RCC_SYSCLK_Div1);
	RCC_PCLK1Config(RCC_HCLK_Div2);
	RCC_PCLK2Config(RCC_HCLK_Div1);
	
	RCC_LSICmd(ENABLE);
	while(RCC_GetFlagStatus(RCC_FLAG_LSIRDY) == RESET);
	RCC_HSICmd(ENABLE);
	while(RCC_GetFlagStatus(RCC_FLAG_HSIRDY) == RESET);
}
void GPIO_Configuration(void)
{
	GPIO_InitTypeDef GPIO_InitStructure;
	RCC_APB2PeriphClockCmd(RCC_APB2Periph_GPIOA,ENABLE);
	
	GPIO_InitStructure.GPIO_Pin = GPIO_Pin_11; 
	GPIO_InitStructure.GPIO_Speed = GPIO_Speed_50MHz;
	GPIO_InitStructure.GPIO_Mode = GPIO_Mode_Out_PP;	
	GPIO_Init(GPIOA, &GPIO_InitStructure);
}
	
void UART_Configuration(uint32_t bound)
{
	GPIO_InitTypeDef GPIO_InitStructure;
	USART_InitTypeDef USART_InitStructure;

	RCC_APB2PeriphClockCmd(RCC_APB2Periph_USART1,ENABLE);
	RCC_APB2PeriphClockCmd(RCC_APB2Periph_GPIOA,ENABLE);

	GPIO_InitStructure.GPIO_Pin = GPIO_Pin_9; 
	GPIO_InitStructure.GPIO_Speed = GPIO_Speed_50MHz;
	GPIO_InitStructure.GPIO_Mode = GPIO_Mode_AF_PP;	
	GPIO_Init(GPIOA, &GPIO_InitStructure);

	GPIO_InitStructure.GPIO_Pin = GPIO_Pin_10;
	GPIO_InitStructure.GPIO_Mode = GPIO_Mode_IN_FLOATING;
	GPIO_Init(GPIOA, &GPIO_InitStructure);
	
	USART_InitStructure.USART_BaudRate = bound;
	USART_InitStructure.USART_WordLength = USART_WordLength_8b;
	USART_InitStructure.USART_StopBits = USART_StopBits_1;
	USART_InitStructure.USART_Parity = USART_Parity_No;
	USART_InitStructure.USART_HardwareFlowControl = USART_HardwareFlowControl_None;
	USART_InitStructure.USART_Mode = USART_Mode_Rx | USART_Mode_Tx;

	USART_Init(USART_TEST, &USART_InitStructure);
	USART_Cmd(USART_TEST, ENABLE);
}


int SER_PutChar (int ch)
{
	while(!USART_GetFlagStatus(USART_TEST,USART_FLAG_TC));
	USART_SendData(USART_TEST, (uint8_t) ch);

	return ch;
}

int fputc(int c, FILE *f)
{
	/* Place your implementation of fputc here */
	/* e.g. write a character to the USART */
	if (c == '\n')
	{
		SER_PutChar('\r');
	}
	return (SER_PutChar(c));
}

